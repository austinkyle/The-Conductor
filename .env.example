# --- Gateway-issued caller keys are stored hashed in the DB, not here. ---

# Provider secrets (referenced by the DB, never stored in it)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Datastores
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Semantic cache
# SEMANTIC_SIMILARITY_THRESHOLD measured via bench/cache_bench.py --mode=similarity;
# see bench/reports/bench-20260713-similarity-threshold.md. Re-run against your own
# traffic if your domain mix differs from the synthetic eval set.
EMBEDDING_MODEL=
SEMANTIC_SIMILARITY_THRESHOLD=0.95
SEMANTIC_TEMPERATURE_BYPASS=0.3

# App
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
